+		/// <summary>先在同卷临时目录写完整 JSON，再发布到资源路径，使已有读取映射可以继续使用旧文件。</summary>
+		/// <param name="savePath">最终清单的路径，仅替换 JSON 文件本身。</param>
+		/// <param name="jsonData">从本轮保存的变体集合生成的完整 JSON 文本。</param>
+		private static async Task WriteManifestFile(string savePath, string jsonData)
+		{
+			// 工程同卷的项目临时目录，不让 Unity 将中间文件作为资源导入。
+			string tempDirectory = Path.GetFullPath(Path.Combine(Application.dataPath, "..", "..", "_temp", "YooAssetShaderManifests"));
+			Directory.CreateDirectory(tempDirectory);
+			// 每次发布独占一个文件名，失败时也只清理本次尚未移走的临时文件。
+			string tempPath = Path.Combine(tempDirectory, Guid.NewGuid().ToString("N") + ".tmp");
+			// 拒绝共享删除的读取句柄可能使 Windows 返回共享冲突或文件映射占用。
+			const int sharingViolation = unchecked((int)0x80070020);
+			// Windows ERROR_USER_MAPPED_FILE 的 HRESULT（1224）。
+			const int userMappedFile = unchecked((int)0x800704C8);
+			// 最多十次延迟重试，持续阻塞后保留最后一次系统异常。
+			const int maxRetries = 10;
+			// 每次等待的毫秒数；编辑器可在这段时间内处理导入与界面更新。
+			const int retryDelayMilliseconds = 200;
+			try
+			{
+				File.WriteAllText(tempPath, jsonData);
+				// 首次发布时为零，同一份临时文件用于后续所有重试。
+				for (int retry = 0; ; retry++)
+				{
+					try
+					{
+						if (File.Exists(savePath))
+							File.Replace(tempPath, savePath, null);
+						else
+							File.Move(tempPath, savePath);
+						return;
+					}
+					// 只等待已验证的 Windows 占用错误，其他 I/O 异常立即上抛。
+					catch (IOException error) when ((error.HResult == sharingViolation || error.HResult == userMappedFile) && retry < maxRetries)
+					{
+						AssetDatabase.ReleaseCachedFileHandles();
+						await Task.Delay(retryDelayMilliseconds);
+					}
+				}
+			}
+			finally
+			{
+				File.Delete(tempPath);
+			}
