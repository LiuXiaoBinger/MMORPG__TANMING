<?xml version="1.0" encoding="utf-8"?>
<!-- 逻辑区号对应角色存档的 ServerId。publicHost 是客户端可连接的地址，host 是本区的内网监听地址。 -->
<realm id="1" name="1区 五域大陆" publicHost="127.0.0.1" host="127.0.0.1" shared="../公共服务.xml" spawnMap="1"
       gatePort="10140" udpPort="10141" masterPort="10150" controlPort="10160" tradeHost="127.0.0.1" tradePort="10170" runState="3" isNew="1">
  <!-- tradeHost / tradePort 为本区所有地图线路共用的交易服地址；tradePort 设为 0 即停用。 -->
  <!-- 共用一个数据库的各区，物理 GS 的 id 也要不同；该编号参与物品 UID 生成。 -->
  <game id="1" host="127.0.0.1" port="10130" />
  <game id="2" host="127.0.0.1" port="10131" />
  <!-- 地图 1 是天空中之城，地图 0 是主城。line 只在所属地图内计数。 -->
  <scene map="1" line="1" game="1" capacity="500" />
  <scene map="1" line="2" game="2" capacity="500" />
  <scene map="0" line="1" game="1" capacity="500" />
  <scene map="0" line="2" game="2" capacity="500" />
</realm>
