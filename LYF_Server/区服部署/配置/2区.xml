<?xml version="1.0" encoding="utf-8"?>
<!-- 逻辑区号对应角色存档的 ServerId。publicHost 是客户端可连接的地址，host 是本区的内网监听地址。 -->
<realm id="2" name="2区 五域大陆" publicHost="127.0.0.1" host="127.0.0.1" shared="../公共服务.xml" spawnMap="1"
       gatePort="10240" udpPort="10241" masterPort="10250" controlPort="10260" runState="3" isNew="1">
  <!-- 共用一个数据库的各区，物理 GS 的 id 也要不同；该编号参与物品 UID 生成。 -->
  <game id="3" host="127.0.0.1" port="10230" />
  <game id="4" host="127.0.0.1" port="10231" />
  <!-- 地图 1 是现有建角出生地图，地图 0 是现有主城编号。line 只在所属地图内计数。 -->
  <scene map="1" line="1" game="3" capacity="500" />
  <scene map="1" line="2" game="4" capacity="500" />
  <scene map="0" line="1" game="3" capacity="500" />
  <scene map="0" line="2" game="4" capacity="500" />
</realm>
