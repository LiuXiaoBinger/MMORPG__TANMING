<?xml version="1.0" encoding="utf-8"?>
<!-- TimelineMode只切换原时间轴的执行器，两种模式共用XML行为树、实例时钟和随机源。 -->
<!-- 所有资源路径相对游戏服发布目录；SkillDirectory包含Tables.xml、SkillData、Lua和Curve。 -->
<!-- NavigationPath选择本地图导航文件；TreeDirectory提供主树及引用树，SceneTree可省略以保留场景XML事件规则。 -->
<!-- 无Timeline时可省略LuaDirectory与TimeAxesPath；Lua模式读取脚本目录，Code模式读取计划XML。 -->
<MoshentaAI TimelineMode="Lua"
    SkillDirectory="Config/Moshenta"
    NavigationPath="NavigationData/sc_dungeon_moshenta_001.navmesh.bytes"
    TreeDirectory="Config/MonsterAI"
    SceneTree="Dungeons_DaNaTuoSiZhiZhan_SceneAI_EZ"
    LuaDirectory="Config/MonsterAI/Lua"
    TimeAxesPath="Config/MonsterAI/TimeAxes.xml">
  <!-- 原NPC表到EntityTable的绑定只属于本副本。 -->
  <Npc npcId="20186" entityId="5456" />
  <!-- entityId选择宿主；script同时是Lua文件主名与全局表名。codeProfile仅支持已有DaNaTuoSi/BossController实现。 -->
  <Timeline entityId="5456" script="Dungeon_DaNaTuoSiZhiZhan_DaNaTuoSi" codeProfile="DaNaTuoSi" />
  <Timeline entityId="5512" script="Dungeon_DaNaTuoSiZhiZhan_BossController_EZ" codeProfile="BossController" />
</MoshentaAI>
